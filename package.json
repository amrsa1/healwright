{
  "name": "healwright",
  "version": "1.8.0",
  "description": "Self-healing locators for Playwright. When a selector breaks, an AI model (OpenAI, Claude, Gemini or a local Ollama model) finds the element you meant, verifies it and caches the fix.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "readme.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --clean && npm run build:types",
    "dev": "tsup src/index.ts --format cjs,esm --watch",
    "test": "SELF_HEAL=1 npx playwright test",
    "test:headed": "SELF_HEAL=1 npx playwright test --headed",
    "test:unit": "vitest run",
    "test:heal": "SELF_HEAL=1 npx playwright test examples/element-zoo-healing.test.ts",
    "test:ci": "npm run typecheck && npm run lint && npm run test:unit && npm run test:heal",
    "lint": "oxlint src tests",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "build:types": "tsc --emitDeclarationOnly",
    "publish:manual": "bash scripts/publish.sh"
  },
  "keywords": [
    "playwright",
    "playwright-test",
    "self-healing",
    "self-healing-tests",
    "auto-healing",
    "locators",
    "selectors",
    "smart-locators",
    "flaky-tests",
    "resilient-tests",
    "testing",
    "test-automation",
    "e2e",
    "end-to-end",
    "e2e-testing",
    "web-testing",
    "qa",
    "browser-automation",
    "ai",
    "ai-testing",
    "llm",
    "openai",
    "gpt",
    "anthropic",
    "claude",
    "gemini",
    "google",
    "ollama",
    "local-llm"
  ],
  "author": "Amr Salem",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amrsa1/healwright.git"
  },
  "bugs": {
    "url": "https://github.com/amrsa1/healwright/issues"
  },
  "homepage": "https://amrsa1.github.io/healwright/",
  "peerDependencies": {
    "@playwright/test": ">=1.62.1",
    "playwright-core": ">=1.60.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@google/genai": "^2.31.0",
    "ollama": "^0.6.4",
    "openai": "^7.43.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "dotenv": "^18.0.9",
    "oxlint": "^1.89.0",
    "playwright-core": ">=1.60.0",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "playwright-core": {
      "optional": true
    }
  },
  "sideEffects": false
}
