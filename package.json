{
  "name": "healwright",
  "version": "1.7.0",
  "description": "AI-powered self-healing locators for Playwright. When locators fail, AI automatically finds the correct element.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "readme.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --clean && npm run build:types",
    "dev": "tsup src/index.ts --format cjs,esm --watch",
    "test": "SELF_HEAL=1 npx playwright test",
    "test:headed": "SELF_HEAL=1 npx playwright test --headed",
    "test:unit": "vitest run",
    "test:heal": "SELF_HEAL=1 npx playwright test examples/element-zoo-healing.test.ts",
    "test:ci": "npm run typecheck && npm run lint && npm run test:unit && npm run test:heal",
    "lint": "oxlint src tests",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "build:types": "tsc --emitDeclarationOnly"
  },
  "keywords": [
    "playwright",
    "testing",
    "automation",
    "self-healing",
    "ai",
    "locators",
    "e2e",
    "end-to-end",
    "web-testing",
    "resilient-tests",
    "gpt",
    "openai",
    "anthropic",
    "claude",
    "gemini",
    "google",
    "ollama",
    "local-llm"
  ],
  "author": "Amr Salem",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amrsa1/healwright.git"
  },
  "bugs": {
    "url": "https://github.com/amrsa1/healwright/issues"
  },
  "homepage": "https://github.com/amrsa1/healwright#readme",
  "peerDependencies": {
    "@playwright/test": ">=1.62.1",
    "playwright-core": ">=1.60.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.118.0",
    "@google/genai": "^2.17.1",
    "ollama": "^0.6.3",
    "openai": "^7.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "dotenv": "^17.4.2",
    "oxlint": "^1.79.0",
    "playwright-core": ">=1.60.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "playwright-core": {
      "optional": true
    }
  },
  "sideEffects": false
}
